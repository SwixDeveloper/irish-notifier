local function isTargetValid(tc)
    if not tc then return false end
    local hum = tc:FindFirstChildOfClass("Humanoid"); local hrp = tc:FindFirstChild("HumanoidRootPart")
    local ff = tc:FindFirstChildOfClass("ForceField")
    return hum and hrp and hum.Health > 0 and not ff
end

local function getBestTarget(myHRP)
    if lockedTarget and isTargetValid(lockedTarget) then return lockedTarget:FindFirstChild("HumanoidRootPart"), lockedTarget end
    local short, newTC, newHRP = math.huge, nil, nil
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp ~= Player and isTargetValid(tp.Character) then
            local th = tp.Character:FindFirstChild("HumanoidRootPart")
            local d = (th.Position - myHRP.Position).Magnitude
            if d < short then short = d; newHRP = th; newTC = tp.Character end
        end
    end
    lockedTarget = newTC; return newHRP, newTC
end

local function startBatAimbot()
    if aimbotConnection then return end
    local c = Player.Character; if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart"); local hum = c:FindFirstChildOfClass("Humanoid"); if not h or not hum then return end
    hum.AutoRotate = false
    local attachment = h:FindFirstChild("AimbotAttachment") or Instance.new("Attachment", h); attachment.Name = "AimbotAttachment"
    local align = h:FindFirstChild("AimbotAlign") or Instance.new("AlignOrientation", h); align.Name = "AimbotAlign"
    align.Mode = Enum.OrientationAlignmentMode.OneAttachment; align.Attachment0 = attachment
    align.MaxTorque = math.huge; align.Responsiveness = 200
    aimbotConnection = RunService.Heartbeat:Connect(function(dt)
        if not Enabled.BatAimbot then return end
        if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
        local cHRP = Player.Character.HumanoidRootPart; local cHum = Player.Character:FindFirstChildOfClass("Humanoid")
        local bat = findBat(); if bat and bat.Parent ~= Player.Character then pcall(function() cHum:EquipTool(bat) end) end
        local targetHRP, targetChar = getBestTarget(cHRP)
        if targetHRP and targetChar then
            aimbotHighlight.Adornee = targetChar
            local tv = targetHRP.AssemblyLinearVelocity; local spd = tv.Magnitude
            local dpt = math.clamp(spd/150, 0.05, 0.2); local pp = targetHRP.Position + (tv * dpt)
            local dir = (pp - cHRP.Position); local d3 = dir.Magnitude
            local tsp = d3 > 0 and (pp - dir.Unit * MELEE_OFFSET) or pp
            align.CFrame = CFrame.lookAt(cHRP.Position, pp)
            local md = tsp - cHRP.Position; local dts = md.Magnitude
            if dts > 1 then cHRP.AssemblyLinearVelocity = md.Unit * AIMBOT_SPEED
            else cHRP.AssemblyLinearVelocity = tv end
        else
            lockedTarget = nil; cHRP.AssemblyLinearVelocity = Vector3.new(0,0,0); aimbotHighlight.Adornee = nil
        end
    end)
end

local function stopBatAimbot()
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
    local c = Player.Character; local h = c and c:FindFirstChild("HumanoidRootPart"); local hum = c and c:FindFirstChildOfClass("Humanoid")
    if h then
        local att = h:FindFirstChild("AimbotAttachment"); if att then att:Destroy() end
        local al = h:FindFirstChild("AimbotAlign"); if al then al:Destroy() end
        h.AssemblyLinearVelocity = Vector3.new(0,0,0)
    end
    if hum then hum.AutoRotate = true end
    lockedTarget = nil; aimbotHighlight.Adornee = nil
end


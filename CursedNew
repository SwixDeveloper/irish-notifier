local function SaveConfig()
    local data = {}
    for k, v in pairs(Enabled) do data[k] = v end
    for k, v in pairs(Values) do data[k] = v end
    for k, v in pairs(KEYBINDS) do data["KEY_"..k] = v.Name end
    local success = false
    if writefile then pcall(function() writefile(ConfigFileName, HttpService:JSONEncode(data)); success = true end) end
    return success
end

local function LoadConfig()
    if not readfile then return false end
    local ok, raw = pcall(readfile, ConfigFileName); if not ok or not raw then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end); if not ok2 or not data then return false end
    for k in pairs(Enabled) do if data[k] ~= nil then Enabled[k] = data[k] end end
    for k in pairs(Values) do if data[k] ~= nil then Values[k] = data[k] end end
    for k in pairs(KEYBINDS) do
        if data["KEY_"..k] then local kc = Enum.KeyCode[data["KEY_"..k]]; if kc then KEYBINDS[k] = kc end end
    end
    return true
end


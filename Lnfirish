-- NO ANIM
-- ============================================
local noAnimConns = {}
local function disableAnims(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end
    if noAnimConns[character] then noAnimConns[character]:Disconnect() end
    noAnimConns[character] = humanoid.AnimationPlayed:Connect(function(track) track:Stop() end)
end
local function startNoAnim()
    if Connections.noAnim then return end
    if Player.Character then disableAnims(Player.Character) end
    Connections.noAnim = Player.CharacterAdded:Connect(function(char) disableAnims(char) end)
end
local function stopNoAnim()
    if Connections.noAnim then Connections.noAnim:Disconnect() Connections.noAnim = nil end
    for char, conn in pairs(noAnimConns) do
        if type(char) ~= "string" then conn:Disconnect() noAnimConns[char] = nil end
    end
end


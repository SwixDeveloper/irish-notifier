    data.CurrentThemeIndex     = CurrentThemeIndex
    data.isRainbow             = isRainbow
    data.CurrentBgEffectIndex  = CurrentBgEffectIndex
    local success = false
    if writefile then
        pcall(function()
            writefile(ConfigFileName, HttpService:JSONEncode(data))
            success = true
        end)
    end
    return success
end

local function LoadConfig()
    if not readfile then return false end
    local ok, raw = pcall(readfile, ConfigFileName)
    if not ok or not raw then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or not data then return false end
    -- Restore toggle states
    for k in pairs(Enabled) do
        if data[k] ~= nil then Enabled[k] = data[k] end
    end
    -- Restore slider values
    for k in pairs(Values) do
        if data[k] ~= nil then Values[k] = data[k] end
    end
    -- Restore keybinds
    local keyMap = {
        KEY_SPEED="SPEED", KEY_SPIN="SPIN", KEY_GALAXY="GALAXY", KEY_BATAIMBOT="BATAIMBOT",
        KEY_AUTOLEFT="AUTOLEFT", KEY_AUTORIGHT="AUTORIGHT", KEY_AUTOPLAYLEFT="AUTOPLAYLEFT",
        KEY_AUTOPLAYRIGHT="AUTOPLAYRIGHT", KEY_ANTIRAGDOLL="ANTIRAGDOLL", KEY_SPEEDSTEAL="SPEEDSTEAL",
        KEY_AUTOSTEAL="AUTOSTEAL", KEY_UNWALK="UNWALK", KEY_OPTIMIZER="OPTIMIZER", KEY_SPAMBAT="SPAMBAT",
        KEY_GALAXY_SKY="GALAXY_SKY", KEY_INFJUMP="INFJUMP", KEY_ESP="ESP", KEY_HOVER="HOVER",
        KEY_STATS="STATS", KEY_SPEEDMETER="SPEEDMETER"
    }
    for dataKey, bindKey in pairs(keyMap) do
        if data[dataKey] then
            local kc = Enum.KeyCode[data[dataKey]]
            if kc then KEYBINDS[bindKey] = kc end
        end
    end
    if data.CurrentThemeIndex then CurrentThemeIndex = data.CurrentThemeIndex end
    if data.isRainbow ~= nil then isRainbow = data.isRainbow end
    if data.CurrentBgEffectIndex then CurrentBgEffectIndex = data.CurrentBgEffectIndex end
    return true
end


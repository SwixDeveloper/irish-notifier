<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Irish Notifier</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Bricolage+Grotesque:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --emerald: #0a9d4e;
      --lime: #4ade80;
      --gold: #facc15;
      --dark-bg: #0a140f;
      --card-bg: #111f18;
      --accent-bg: #1a2f22;
      --line: rgba(74,222,128,0.15);
      --text: #f1f5f9;
      --text-light: #a3e7b8;
      --text-muted: #6b8c79;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{background:var(--dark-bg);color:var(--text);font-family:var(--mono);min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden}

    body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");background-size:200px;pointer-events:none;z-index:9999;opacity:.3}

    .amb{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
    .orb{position:absolute;border-radius:50%;filter:blur(90px)}
    .o1{width:420px;height:420px;background:rgba(10,157,78,0.08);top:-140px;left:-110px}
    .o2{width:310px;height:310px;background:rgba(74,222,128,0.06);bottom:-40px;right:-80px}

    /* LOGIN */
    #lp{position:relative;z-index:1;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
    .lcard{background:var(--card-bg);border:1px solid var(--line);border-radius:28px;padding:48px 36px;width:100%;max-width:360px;text-align:center;position:relative;overflow:hidden;animation:riseIn .6s cubic-bezier(.16,1,.3,1) both}
    .lcard::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--lime),transparent);opacity:.6}
    @keyframes riseIn{from{opacity:0;transform:translateY(30px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}

    .logo-wrap{position:relative;display:inline-block;margin-bottom:26px}
    .logo-glow{position:absolute;inset:-24px;background:radial-gradient(circle,rgba(74,222,128,.45) 0%,transparent 70%);border-radius:50%;animation:pg 3s ease-in-out infinite}
    .logo-img{width:96px;height:96px;border-radius:22px;overflow:hidden;box-shadow:0 0 50px rgba(74,222,128,0.65);animation:fy 4s ease-in-out infinite;display:flex;align-items:center;justify-content:center;font-size:58px;background:linear-gradient(135deg,#0a9d4e,#4ade80);color:#052e10}
    @keyframes pg{0%,100%{opacity:.8;transform:scale(1)}50%{opacity:1;transform:scale(1.2)}}
    @keyframes fy{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}

    .ltitle{font-family:var(--display);font-size:32px;font-weight:800;letter-spacing:-.5px;margin-bottom:6px;color:var(--text)}
    .ltag{font-size:11px;color:var(--text-muted);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:34px}

    .dbtn{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:var(--lime);color:#052e10;border:none;border-radius:13px;padding:15px 20px;font-family:var(--mono);font-size:13px;font-weight:600;letter-spacing:.4px;cursor:pointer;transition:all .2s cubic-bezier(.34,1.56,.64,1);position:relative;overflow:hidden}
    .dbtn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.18) 0%,transparent 60%)}
    .dbtn:hover{transform:translateY(-3px) scale(1.03);box-shadow:0 10px 32px rgba(74,222,128,.45)}
    .dbtn:active{transform:scale(.97)}
    .dbtn svg{width:20px;height:20px;fill:#052e10;flex-shrink:0}
    .lfooter{margin-top:18px;font-size:11px;color:var(--text-muted);letter-spacing:.4px}

    /* DASHBOARD */
    #db{display:none;position:relative;z-index:1;min-height:100vh}

    nav{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 18px;height:56px;background:rgba(10,20,15,.92);backdrop-filter:blur(22px);border-bottom:1px solid var(--line)}
    .nbrand{display:flex;align-items:center;gap:10px}
    .nicon{width:34px;height:34px;border-radius:9px;overflow:hidden;box-shadow:0 0 16px rgba(74,222,128,.5);display:flex;align-items:center;justify-content:center;font-size:22px;background:linear-gradient(135deg,#0a9d4e,#4ade80);color:#052e10}
    .nname{font-family:var(--display);font-size:15px;font-weight:700;color:var(--text)}
    .nacts{display:flex;align-items:center;gap:8px}
    .uchip{display:flex;align-items:center;gap:7px;background:var(--accent-bg);border:1px solid var(--line);border-radius:20px;padding:4px 12px 4px 6px;cursor:pointer}
    .uav{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,var(--emerald),var(--lime));display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#052e10;flex-shrink:0}
    .uname{font-size:12.5px;font-weight:500;color:var(--text-light)}
    .logoutbtn{width:32px;height:32px;border-radius:8px;background:var(--accent-bg);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-muted);transition:all .15s}
    .logoutbtn:hover{color:var(--lime);background:var(--card-bg)}

    .tabrow{padding:14px 18px 0;display:flex;gap:3px}
    .tab{display:flex;align-items:center;gap:7px;padding:9px 15px;border-radius:10px;background:none;border:none;font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--text-muted);cursor:pointer;transition:all .15s}
    .tab svg{width:14px;height:14px;opacity:.75}
    .tab:hover{color:var(--text-light);background:var(--accent-bg)}
    .tab.on{background:var(--lime);color:#052e10;font-weight:600}
    .tab.on svg{opacity:1}

    .wrap{padding:24px 18px 60px;max-width:540px}
    .page{display:none;animation:fs .22s ease both}
    .page.on{display:block}
    @keyframes fs{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

    .ph{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}
    .ph-title{font-family:var(--display);font-size:27px;font-weight:800;color:var(--text);letter-spacing:-.45px}
    .ph-meta{font-size:11.5px;color:var(--text-muted);margin-top:4px;letter-spacing:.2px}
    .pill{font-size:10px;padding:4px 10px;border-radius:20px;font-weight:600;letter-spacing:.4px}
    .pg{background:rgba(74,222,128,.12);color:var(--lime);border:1px solid rgba(74,222,128,.25)}

    .card{background:var(--card-bg);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:12px;position:relative;overflow:hidden}
    .card:hover{border-color:rgba(74,222,128,0.4)}
    .cs{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--lime),transparent);opacity:.6}

    .sbrow{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
    .sid{font-size:12px;color:var(--text-muted);font-weight:500;letter-spacing:.5px}
    .badge{font-size:10px;letter-spacing:1.4px;font-weight:600;padding:3px 10px;border-radius:6px}
    .btaken{background:var(--accent-bg);color:var(--text-muted);border:1px solid var(--line)}
    .suc{display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:14px}
    .sav{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--emerald),var(--lime));display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:18px;font-weight:800;color:#052e10;box-shadow:0 0 20px rgba(74,222,128,.3)}
    .sun{font-family:var(--display);font-size:16px;font-weight:700;color:var(--text)}
    .strow{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text-muted);justify-content:center;margin-bottom:12px}
    .sdiv{height:1px;background:var(--line);margin-bottom:12px}
    .sstatus{text-align:center;font-size:10.5px;letter-spacing:2.2px;color:var(--text-muted);font-weight:600}

    .qcard{background:linear-gradient(135deg,rgba(10,157,78,.1) 0%,var(--card-bg) 100%);border:1px solid rgba(74,222,128,.2);border-radius:16px;padding:18px;margin-bottom:12px}
    .qtitle{display:flex;align-items:center;gap:8px;font-family:var(--display);font-size:16.5px;font-weight:700;color:var(--lime);margin-bottom:6px}
    .qdesc{font-size:12.5px;color:var(--text-muted);line-height:1.55;margin-bottom:16px}
    .cdpill{background:var(--dark-bg);border:1px solid var(--line);border-radius:12px;padding:14px 17px;display:flex;align-items:center;gap:14px}
    .cdlabel{font-size:9.5px;letter-spacing:2.2px;color:var(--text-muted);font-weight:600;margin-bottom:1px;text-transform:uppercase}
    .cdtime{font-size:25px;font-weight:400;color:var(--lime);letter-spacing:3px;font-variant-numeric:tabular-nums}

    .acard{background:var(--card-bg);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:12px}
    .alabel{display:flex;align-items:center;gap:7px;font-size:10.5px;letter-spacing:1.9px;color:var(--text-muted);font-weight:600;margin-bottom:14px;text-transform:uppercase}
    .estate{text-align:center;padding:4px 0 14px}
    .eicon{width:40px;height:40px;border-radius:12px;background:var(--accent-bg);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-muted)}
    .etxt{font-size:12.5px;color:var(--text-muted);line-height:1.6;margin-bottom:16px}

    .btnp{width:100%;background:var(--lime);color:#052e10;border:none;border-radius:12px;padding:14px;font-family:var(--mono);font-size:12.5px;font-weight:600;letter-spacing:.9px;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .18s;position:relative;overflow:hidden}
    .btnp::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.2) 0%,transparent 65%)}
    .btnp:hover{background:var(--gold);transform:translateY(-1px);box-shadow:0 6px 22px rgba(250,204,21,.3)}
    .btnp:active{transform:scale(.98)}

    .equeue{background:var(--card-bg);border:1px dashed var(--line);border-radius:16px;padding:32px 18px;text-align:center;margin-bottom:12px}
    .eq-em{font-size:28px;margin-bottom:12px;opacity:.4}
    .eq-t{font-family:var(--display);font-size:15px;font-weight:700;color:var(--text-muted);margin-bottom:6px}
    .eq-s{font-size:12.5px;color:var(--text-muted);line-height:1.55}

    .qlabel{display:flex;align-items:center;gap:7px;font-size:10.5px;letter-spacing:2px;color:var(--text-muted);font-weight:600;margin-bottom:10px;text-transform:uppercase;padding:0 3px}
    .qlabel svg{width:12px;height:12px}

    .lbsub{font-size:12.5px;color:var(--text-muted);margin-bottom:20px;letter-spacing:.3px}
    .lbme{background:linear-gradient(135deg,rgba(10,157,78,.1) 0%,var(--card-bg) 100%);border:1px solid rgba(74,222,128,.25);border-radius:16px;padding:18px;display:flex;align-items:center;gap:14px;margin-bottom:12px;position:relative;overflow:hidden}
    .lbme::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(74,222,128,.5),transparent)}
    .lbrk{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:14px;font-weight:800;flex-shrink:0;background:var(--lime);color:#052e10}
    .lbav{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--emerald),var(--lime));display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:17px;font-weight:800;color:#052e10;flex-shrink:0;box-shadow:0 0 18px rgba(74,222,128,.35)}
    .lbinfo{flex:1}
    .lbn{font-family:var(--display);font-size:15px;font-weight:700;color:var(--text);margin-bottom:3px}
    .lbs2{font-size:11.5px;color:var(--text-muted)}
    .lbr{text-align:right}
    .lbamt{font-family:var(--display);font-size:17px;font-weight:800;color:var(--lime)}
    .lbaml{font-size:10.5px;color:var(--text-muted);letter-spacing:.4px}

    .lbempty{background:var(--card-bg);border:1px dashed var(--line);border-radius:16px;padding:38px 18px;text-align:center}
    .lbet{font-size:13px;color:var(--text-muted);line-height:1.6}

    .balcard{background:linear-gradient(135deg,rgba(10,157,78,.12) 0%,var(--card-bg) 65%);border:1px solid rgba(74,222,128,.22);border-radius:22px;padding:28px 24px;margin-bottom:20px;position:relative;overflow:hidden}
    .balcard::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--lime),transparent)}
    .ballabel{display:flex;align-items:center;gap:7px;font-size:10.5px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;font-weight:600;margin-bottom:14px}
    .balamount{font-family:var(--display);font-size:46px;font-weight:800;color:var(--lime);letter-spacing:-2.5px;margin-bottom:6px}
    .balsub{font-size:12.5px;color:var(--text-muted);margin-bottom:24px}

    /* PayPal Section with Very Large $5 Button */
    .paypal-section{margin-top:20px}
    .quick-pay-title{font-size:13px;color:var(--text-light);margin-bottom:12px;text-align:center;font-weight:600}
    .paypal-options{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}

    .paypal-btn.big{
      background:var(--gold);
      color:#052e10;
      border:none;
      border-radius:14px;
      padding:22px 44px;
      font-family:var(--mono);
      font-size:22px;
      font-weight:700;
      cursor:pointer;
      transition:all .2s;
      box-shadow:0 12px 35px rgba(250,204,21,0.55);
      min-width:200px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
    }
    .paypal-btn.big:hover{
      transform:translateY(-5px) scale(1.08);
      box-shadow:0 16px 40px rgba(250,204,21,0.65);
    }

    .paypal-btn{
      background:var(--lime);
      color:#052e10;
      border:none;
      border-radius:11px;
      padding:13px 22px;
      font-family:var(--mono);
      font-size:13px;
      font-weight:600;
      cursor:pointer;
      transition:all .18s;
      min-width:85px;
    }
    .paypal-btn:hover{
      background:var(--gold);
      transform:translateY(-2px);
    }

    .txtitle{display:flex;align-items:center;gap:9px;font-family:var(--display);font-size:17.5px;font-weight:700;color:var(--text);margin-bottom:14px}
    .txempty{background:var(--card-bg);border:1px dashed var(--line);border-radius:16px;padding:46px 18px;text-align:center}
    .txei{width:44px;height:44px;border-radius:13px;background:var(--accent-bg);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;color:var(--text-muted)}
    .txet{font-family:var(--display);font-size:15px;font-weight:700;color:var(--text-muted);margin-bottom:6px}
    .txes{font-size:12.5px;color:var(--text-muted)}

    /* modal */
    .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);backdrop-filter:blur(12px);z-index:100;align-items:flex-end;justify-content:center}
    .overlay.open{display:flex;animation:fo .14s ease}
    @keyframes fo{from{opacity:0}to{opacity:1}}
    .modal{background:var(--card-bg);border:1px solid var(--line);border-top:none;border-radius:26px 26px 0 0;padding:24px 24px 48px;width:100%;max-width:540px;animation:su .28s cubic-bezier(.16,1,.3,1)}
    @keyframes su{from{transform:translateY(80px);opacity:0}to{transform:translateY(0);opacity:1}}
    .mpull{width:36px;height:4px;background:var(--text-muted);border-radius:3px;margin:0 auto 22px}
    .mline{height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);margin-bottom:22px}
    .mtitle{font-family:var(--display);font-size:21px;font-weight:800;color:var(--text);letter-spacing:-.35px;margin-bottom:6px}
    .mdesc{font-size:13px;color:var(--text-muted);line-height:1.65;margin-bottom:24px}
    .mlabel{font-size:10.5px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;font-weight:600;margin-bottom:8px}
    .mwrap{display:flex;align-items:center;background:var(--accent-bg);border:1px solid var(--line);border-radius:12px;padding:0 16px;margin-bottom:20px;transition:border-color .15s}
    .mwrap:focus-within{border-color:var(--lime)}
    .msym{font-family:var(--display);font-size:21px;font-weight:800;color:var(--lime);margin-right:8px;opacity:.85}
    .minp{flex:1;background:none;border:none;outline:none;font-family:var(--display);font-size:21px;font-weight:800;color:var(--text);padding:15px 0}
    .minp::placeholder{color:var(--text-muted)}
    .btncancel{width:100%;background:none;border:none;color:var(--text-muted);font-family:var(--mono);font-size:12.5px;cursor:pointer;padding:14px;margin-top:8px;transition:color .15s}
    .btncancel:hover{color:var(--text)}
  </style>
</head>
<body>

<div class="amb"><div class="orb o1"></div><div class="orb o2"></div></div>

<!-- LOGIN -->
<div id="lp">
  <div class="lcard">
    <div class="logo-wrap">
      <div class="logo-glow"></div>
      <div class="logo-img">🍀</div>
    </div>
    <div class="ltitle">Irish Notifier</div>
    <div class="ltag">Premium slot access · Discord verified</div>

    <button class="dbtn" onclick="authorizeDiscord()">
      <svg viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.08.11 18.1.12 18.116a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
      Authorize with Discord
    </button>

    <p class="lfooter">Verified Discord accounts only • Irish luck required 🍀</p>
  </div>
</div>

<!-- DASHBOARD -->
<div id="db">
  <nav>
    <div class="nbrand">
      <div class="nicon">🍀</div>
      <span class="nname">Irish Notifier</span>
    </div>
    <div class="nacts">
      <div class="uchip">
        <div class="uav" id="uav">N</div>
        <span class="uname" id="uname">Noah</span>
      </div>
      <button class="logoutbtn" onclick="logout()">✕</button>
    </div>
  </nav>

  <div class="tabrow">
    <button class="tab on" onclick="gt('slots',this)">Slots</button>
    <button class="tab" onclick="gt('lb',this)">Leaderboard</button>
    <button class="tab" onclick="gt('dep',this)">Deposits</button>
  </div>

  <div class="wrap">

    <!-- SLOTS -->
    <div class="page on" id="pg-slots">
      <div class="ph">
        <div><div class="ph-title">Slots</div><div class="ph-meta">$5.00 / hr &nbsp;·&nbsp; min 3h</div></div>
        <span class="pill pg">1/1 active</span>
      </div>

      <div class="card">
        <div class="cs"></div>
        <div class="sbrow">
          <span class="sid">#01</span>
          <span class="badge btaken">TAKEN</span>
        </div>
        <div class="suc">
          <div class="sav" id="s-av">N</div>
          <span class="sun" id="s-un">Noah</span>
        </div>
        <div class="strow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="elapsed">0h 0m</span>
        </div>
        <div class="sdiv"></div>
        <div class="sstatus">ACTIVE</div>
      </div>

      <div class="qcard">
        <div class="qtitle">Slot Queue</div>
        <div class="qdesc">All slots occupied — highest bid gets the next free slot.</div>
        <div class="cdpill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <div class="cdlabel">Next slot in</div>
            <div class="cdtime" id="cd">04:53:00</div>
          </div>
        </div>
      </div>

      <div class="acard">
        <div class="alabel">Your Bid</div>
        <div class="estate">
          <div class="eicon">ℹ️</div>
          <div class="etxt">No active bid.<br>Place one to join the queue.</div>
          <button class="btnp" onclick="om('bid')">Place a Bid</button>
        </div>
      </div>

      <div class="qlabel">Bid Queue <span class="pill pd">0</span></div>
      <div class="equeue">
        <div class="eq-em">🍀</div>
        <div class="eq-t">No bids yet</div>
        <div class="eq-s">Be the first to place a bid and claim the next slot with Irish luck.</div>
      </div>

      <div class="qcard" style="margin-top:10px;">
        <div class="qtitle" style="color:var(--text)">Pre-order Next Slot</div>
        <div class="qdesc">Pay now · get a full 24h slot automatically when the next one opens.</div>
        <button class="btnp" onclick="om('pre')">Pre-order — $5.00</button>
      </div>
    </div>

    <!-- LEADERBOARD -->
    <div class="page" id="pg-lb">
      <div class="ph-title" style="margin-bottom:5px">Leaderboard</div>
      <div class="lbsub">Top depositors ranked by total spend</div>
      <div class="lbme">
        <div class="lbrk">1</div>
        <div class="lbav" id="lb-av">N</div>
        <div class="lbinfo">
          <div class="lbn" id="lb-n">Noah</div>
          <div class="lbs2">0h purchased</div>
        </div>
        <div class="lbr">
          <div class="lbamt">$0.00</div>
          <div class="lbaml">total spent</div>
        </div>
      </div>
      <div class="lbempty">
        <div class="lbet">No other users yet.<br>Be the first on the board 🍀</div>
      </div>
    </div>

    <!-- DEPOSITS with Very Large $5 Button -->
    <div class="page" id="pg-dep">
      <div class="balcard">
        <div class="ballabel">Account Balance</div>
        <div class="balamount">$0.00</div>
        <div class="balsub">Available to spend on slots</div>

        <div class="paypal-section">
          <div class="quick-pay-title">Quick Pay Options</div>
          <div class="paypal-options">
            <!-- Very Large $5 Button -->
            <button class="paypal-btn big" onclick="quickPayPal(5)">
              💵 $5 Quick Pay
            </button>
            <button class="paypal-btn" onclick="quickPayPal(10)">$10</button>
            <button class="paypal-btn" onclick="quickPayPal(25)">$25</button>
            <button class="paypal-btn" onclick="quickPayPal(50)">$50</button>
          </div>
          <button class="btnadd" onclick="addFundsPayPal()" style="width:100%;margin-top:16px">
            💰 Custom Amount with PayPal
          </button>
        </div>
      </div>

      <div class="txtitle">Transaction History</div>
      <div class="txempty">
        <div class="txei">💳</div>
        <div class="txet">No transactions yet</div>
        <div class="txes">Add funds via PayPal to get started</div>
      </div>
    </div>

  </div>
</div>

<!-- Modals -->
<div class="overlay" id="bid" onclick="oc(event,'bid')">
  <div class="modal">
    <div class="mpull"></div>
    <div class="mline"></div>
    <div class="mtitle">Place a Bid</div>
    <div class="mdesc">Enter your bid. The highest bidder claims the next open slot. Minimum $5.00.</div>
    <div class="mlabel">Bid Amount</div>
    <div class="mwrap"><span class="msym">$</span><input class="minp" type="number" placeholder="0.00" min="5" step="0.01" id="bidinp"></div>
    <button class="btnp" onclick="sbid()">Confirm Bid</button>
    <button class="btncancel" onclick="cm('bid')">Cancel</button>
  </div>
</div>

<div class="overlay" id="pre" onclick="oc(event,'pre')">
  <div class="modal">
    <div class="mpull"></div>
    <div class="mline"></div>
    <div class="mtitle">Pre-order Next Slot</div>
    <div class="mdesc">Pay $5.00 now and automatically receive the next 24h slot when it opens.</div>
    <button class="btnp" onclick="spre()">Confirm Pre-order — $5.00</button>
    <button class="btncancel" onclick="cm('pre')">Cancel</button>
  </div>
</div>

<script>
  const discordAuthUrl = "https://discord.com/oauth2/authorize?client_id=1487012446333042729&response_type=code&redirect_uri=https%3A%2F%2Fdiscord.com%2Foauth2%2Fauthorize%3Fclient_id%3D1487012446333042729%26permissions%3D8%26integration_type%3D0%26scope%3Dbot&scope=identify+email";
  const paypalBaseUrl = "https://www.paypal.com/paypalme/seanuezu";

  function authorizeDiscord() {
    window.open(discordAuthUrl, "_blank");
    setTimeout(() => {
      if (confirm("Discord authorization opened in a new tab.

After authorizing the Irish Notifier bot, click OK to enter the dashboard.")) {
        document.getElementById('lp').style.display = 'none';
        document.getElementById('db').style.display = 'block';
        ['uav','s-av','lb-av'].forEach(id => document.getElementById(id).textContent = 'N');
        ['uname','s-un','lb-n'].forEach(id => document.getElementById(id).textContent = 'Noah');
        startElapsed();
      }
    }, 800);
  }

  function addFundsPayPal() {
    window.open(paypalBaseUrl, "_blank");
    setTimeout(() => {
      alert("✅ PayPal.me opened!

Send any custom amount to seanuezu.
Your balance will be updated after confirmation.");
    }, 600);
  }

  function quickPayPal(amount) {
    const url = `( {paypalBaseUrl}/ ){amount}`;
    window.open(url, "_blank");
    setTimeout(() => {
      alert(`✅ $${amount} PayPal payment opened!

Thank you for supporting Irish Notifier 🍀`);
    }, 600);
  }

  function logout() {
    document.getElementById('db').style.display = 'none';
    document.getElementById('lp').style.display = 'flex';
  }

  function gt(id, btn) {
    document.querySelectorAll('.tab').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
    const pg = document.getElementById('pg-' + id);
    if (pg) pg.classList.add('on');
  }

  let secs = 4*3600 + 53*60;
  setInterval(() => {
    if (secs > 0) secs--;
    const h = String(Math.floor(secs / 3600)).padStart(2, '0');
    const m = String(Math.floor((secs % 3600) / 60)).padStart(2, '0');
    const s = String(secs % 60).padStart(2, '0');
    const el = document.getElementById('cd');
    if (el) el.textContent = `( {h}: ){m}:${s}`;
  }, 1000);

  let emins = 0;
  function startElapsed() {
    setInterval(() => {
      emins++;
      const el = document.getElementById('elapsed');
      if (el) el.textContent = `${Math.floor(emins / 60)}h ${emins % 60}m`;
    }, 60000);
  }

  function om(id) { document.getElementById(id).classList.add('open'); }
  function cm(id) { document.getElementById(id).classList.remove('open'); }
  function oc(e, id) { if (e.target === document.getElementById(id)) cm(id); }

  function sbid() {
    const v = parseFloat(document.getElementById('bidinp').value);
    if (!v || v < 5) { alert('Minimum bid is $5.00'); return; }
    cm('bid');
    alert('Bid of $' + v.toFixed(2) + ' placed! 🍀');
  }
  function spre() { cm('pre'); alert('Pre-order confirmed! You'll get the next slot automatically. 🍀'); }
  function sfunds() { alert("Use the PayPal options on the Deposits page."); }
</script>
</body>
</html>
